{
  "name": "crm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Team sales CRM — Express + better-sqlite3 API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
